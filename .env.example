# PostgreSQL with pgvector
DATABASE_URL="postgresql://user:pass@host/database?sslmode=require&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://user:pass@direct-host/database?sslmode=require"

# Generate a random secret. Existing NEXTAUTH_SECRET is also supported.
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Environment credentials take priority over legacy saved provider settings.
GEMINI_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

AI_REQUESTS_PER_MINUTE="10"
AI_REQUESTS_PER_DAY="500"
# Enable only behind a proxy that replaces client-supplied forwarding headers.
TRUST_PROXY="false"
# Private durable directory; defaults to data/exports/backups.
# BACKUP_DIRECTORY="D:/private-backups/luolinguaai"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional comma-separated public bundled-client preview origins. No credentials
# or private APIs are exposed by this setting. Standard Capacitor origins work
# without this setting; use a browser localhost origin during development.
# APP_PUBLIC_CLIENT_ORIGINS="http://127.0.0.1:5173,http://127.0.0.1:4173"
NRF_REPOSITORY_NAMESPACE="JOOUST/NRF/LuoAI_Repository"

# Account recovery, verification and optional OAuth providers
APP_PUBLIC_URL="http://localhost:3000"
EMAIL_PROVIDER="resend"
EMAIL_FROM=""
EMAIL_API_KEY=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
# Explicit development preview origins (public reads and bearer-only features).
APP_PUBLIC_CLIENT_ORIGINS="http://127.0.0.1:4173,http://127.0.0.1:5173"
APP_NATIVE_CLIENT_ORIGINS="http://127.0.0.1:4173,http://127.0.0.1:5173"
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
